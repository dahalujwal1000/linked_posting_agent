# Leave blank to run the complete interface with local demo data.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase renamed this key. Paste whichever name your dashboard shows; either one works.
# Newer projects: NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Older projects: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service_role JWT (eyJ...) or secret key (sb_secret_...). Never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_URL=http://localhost:3000

# AI providers (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL_1=google/gemma-4-31b-it:free
OPENROUTER_MODEL_2=qwen/qwen3.8-27b:free
OPENROUTER_MODEL_3=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional approval email
RESEND_API_KEY=
RESEND_FROM=

# Feature-flagged official LinkedIn API
LINKEDIN_API_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
